{
  "name": "wickline",
  "version": "0.1.6",
  "description": "Free, open-source charting platform: desktop app or static site. Live crypto, stocks, forex, 100 indicators, your own JavaScript indicators and strategies with backtesting and a community library, drawing tools, alerts and option chains.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "update-data": "node scripts/update-data.mjs",
    "update-vendor": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/lightweight-charts/dist/lightweight-charts.standalone.production.mjs','public/vendor/lightweight-charts.mjs');fs.copyFileSync('node_modules/lightweight-charts/LICENSE','public/vendor/LICENSE-lightweight-charts.txt')\"",
    "test": "node test/backtest.test.mjs && node test/strategy-worker.test.mjs && node test/benchmark-data.test.mjs && node test/viewport.test.mjs && node test/indicator-extensions.test.mjs && node test/clean-bars.test.mjs && node test/indicators.test.mjs && node test/data.test.mjs && node test/screener.test.mjs && node test/news.test.mjs && node test/paper.test.mjs && node test/heatmap.test.mjs && node test/heatmap-markets.test.mjs && node test/options.test.mjs && node test/layout.test.mjs && node test/script-sanitize.test.mjs && node test/community.test.mjs && node test/update.test.mjs && node test/server.test.mjs && node test/timeframes.test.mjs",
    "test:e2e": "electron test/e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "charts",
    "trading",
    "candlestick",
    "crypto",
    "stocks",
    "technical-analysis"
  ],
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "lightweight-charts": "^5.3.0"
  },
  "author": "Wickline contributors",
  "build": {
    "appId": "io.github.wickline.desktop",
    "productName": "Wickline",
    "copyright": "Wickline contributors · MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.mjs",
      "lib/**",
      "community/**",
      "public/**",
      "desktop/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-for-Windows-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-for-Windows-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-Mac-${arch}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Wickline contributors",
      "icon": "build/icon.png",
      "artifactName": "${productName}-Linux-${version}.${ext}"
    }
  }
}
